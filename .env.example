# Copy to .env and replace secrets for your environment.

# Memory backup hardening
VERA_BACKUP_MANIFEST_HMAC_KEY=replace-with-strong-secret
VERA_MAX_BACKUP_AGE_MS=86400000
VERA_BACKUP_INTERVAL_MS=3600000
VERA_MAX_MEMORY_BACKUPS=20

# Model backpressure and availability controls
VERA_MAX_PENDING_REQUESTS=20
VERA_REQUEST_TIMEOUT_MS=90000
VERA_MAX_RESTARTS_PER_WINDOW=5
VERA_RESTART_WINDOW_MS=60000
VERA_CIRCUIT_OPEN_MS=30000
VERA_MAX_EXTRACTED_FILE_TEXT_CHARS=50000

# Retrieval learning controls
VERA_RETRIEVAL_MAX_DOCS=5000
VERA_RETRIEVAL_CHUNK_SIZE=900
VERA_RETRIEVAL_CHUNK_OVERLAP=150
VERA_RETRIEVAL_TOP_K=4
VERA_RETRIEVAL_MAX_CONTEXT_CHARS=2800
VERA_RETRIEVAL_USE_EMBEDDINGS=true
VERA_RETRIEVAL_EMBED_DIM=128

# Conversation + tool loop controls
VERA_SHORT_TERM_HISTORY_TURNS=4
VERA_TOOL_MAX_ITERATIONS=4
VERA_TOOL_LOOP_MAX_MS=120000
# Background agent_run worker (multi-step toward a goal)
# VERA_AGENT_TOOL_LOOP_MAX_MS=180000
# VERA_AGENT_STEP_TIMEOUT_MS=300000

# SQLite robustness (WAL + busy wait)
# VERA_SQLITE_BUSY_TIMEOUT_MS=5000

# Tool loop — cap JSON passed into synthesis (chars)
# VERA_TOOL_SYNTHESIS_MAX_CHARS=24000

# Per-route queue controls
VERA_MAX_PENDING_REQUESTS_PER_ROUTE=20

# Local GGUF — default route (always required as fallback)
# VERA_MODEL_PATH=models/JSON-llama3-fp16.Q4_K_M.gguf

# Multi-model routing (optional): JSON map of route id → GGUF path. Merged with VERA_MODEL_PATH for "default" if omitted.
# Example: VERA_MODEL_ROUTES={"default":"models/general.gguf","coder":"models/code.gguf","legal":"models/legal.gguf"}
# VERA_ROUTE_KEYWORDS={"coder":["rust","debug"],"legal":["contract"]}
# VERA_ROUTE_DEFAULT=default

# Outcome verification for agent_run (second LLM pass; set false to skip)
# VERA_AGENT_OUTCOME_VERIFY=true

# Policy budgets (defaults shown; can override per task via payload.policy)
# VERA_AGENT_MAX_TOOL_INVOCATIONS=128
# VERA_AGENT_MAX_SANDBOX_RUNS=8
# VERA_AGENT_MAX_HTTP_FETCH=16
# Comma list — tools requiring explicit approval unless allowSandbox/allowHttpFetch or approvedSensitiveTools
# VERA_AGENT_SENSITIVE_TOOLS=code_sandbox,http_fetch

# Workspace writes (workspace_write tool)
# VERA_WORKSPACE_WRITE_ENABLED=false
# VERA_WORKSPACE_WRITE_REQUIRE_APPROVAL=true

# Webhook enqueue + scheduler
# VERA_WEBHOOK_SECRET=replace-with-random-secret
# Optional HMAC over raw JSON body (hex digest); requires x-vera-timestamp within VERA_WEBHOOK_MAX_SKEW_MS
# VERA_WEBHOOK_SIGNING_SECRET=can-match-VERA_WEBHOOK_SECRET
# VERA_WEBHOOK_MAX_SKEW_MS=300000
# VERA_SCHEDULER_ENABLED=false
# VERA_SCHEDULER_POLL_MS=30000

# Per-mode tool iterations (optional overrides for ask/plan/debug/agent)
# VERA_MODE_ASK_TOOL_ITERATIONS=1

# Workspace tools (workspace_read / workspace_list)
# VERA_WORKSPACE_ROOT=.

# Bounded HTTP GET for allowlisted hosts (off by default)
# VERA_HTTP_FETCH_ENABLED=false
# VERA_HTTP_FETCH_ALLOWLIST=localhost,127.0.0.1,example.com
# VERA_HTTP_FETCH_MAX_BYTES=500000
# VERA_HTTP_FETCH_TIMEOUT_MS=15000

# Fine-tune pipeline paths (optional overrides)
# VERA_FINETUNE_APPROVED_FILE=training/approved_sessions.txt
# VERA_FINETUNE_DATASET_FILE=training/dataset.jsonl
# VERA_FINETUNE_OUTPUT_DIR=training/artifacts
# VERA_FINETUNE_BASE_MODEL=models/JSON-llama3-fp16.Q4_K_M.gguf

# Persistent memory (SQLite system of record; legacy JSON imported once on first run)
# VERA_MEMORY_DB_PATH=memory/vera_memory.db
# VERA_LONGTERM_FILE=memory/longterm.json
# VERA_RETRIEVAL_INDEX_FILE=memory/retrieval_index.json
# VERA_SESSIONS_DIR=memory/sessions
# VERA_BACKUPS_DIR=memory/backups
# VERA_MEMORY_RETENTION_DAYS_EVENTS=0
# VERA_MEMORY_RETENTION_DAYS_CHUNKS=0
# VERA_RETRIEVAL_INDEX_FILE=memory/retrieval_index.json

# Optional scoped auth for admin/memory/agent endpoints and agent_run tasks
# VERA_ADMIN_API_KEY=replace-with-strong-api-key
# VERA_MEMORY_API_KEY=optional-key-for-memory-and-agent-routes-without-admin
# SQLite API keys (npm run keys:add): hash raw keys with VERA_API_KEY_PEPPER
# VERA_API_KEY_PEPPER=replace-with-random-pepper

# External query embeddings (OpenAI-compatible; optional — improves retrieval when set)
# VERA_EMBEDDING_HTTP_URL=https://api.openai.com/v1/embeddings
# VERA_EMBEDDING_API_KEY=
# VERA_EMBEDDING_MODEL=text-embedding-3-small

# Task worker: attempts before dead_letter status (default 3)
# VERA_TASK_MAX_ATTEMPTS=3

# Append-only audit log (SQLite audit_events); disable with false
# VERA_AUDIT_LOG_ENABLED=true

# Index verified agent outcomes into RAG (session global_lessons) for self-improvement via retrieval
# VERA_OUTCOME_LESSONS_TO_RAG=false

# Multi-agent: agent_run payload { "createCoordination": true } or "coordinationId": "<uuid>" shares a message bus across runs

# HTTP JSON body size (Express limit string, e.g. 256kb)
# VERA_JSON_BODY_LIMIT=256kb

# Agent session + agent_run enqueue limits
# VERA_AGENT_MAX_GOAL_CHARS=8000
# VERA_AGENT_MAX_PLAN_CHARS=16000
# VERA_AGENT_MAX_STEPS=32
# VERA_AGENT_RUN_RATE_LIMIT=20
# VERA_AGENT_RUN_RATE_WINDOW_MS=60000

# Structured JSON logs to stdout (agent/task events when enabled in code paths)
# VERA_STRUCTURED_LOGS=true

# Sandbox audit log (append-only JSONL; set false to disable)
# VERA_SANDBOX_AUDIT=true
# VERA_SANDBOX_AUDIT_FILE=memory/sandbox_audit.jsonl

# Worker controls
# VERA_WORKER_POLL_MS=2000
# VERA_WORKER_ID=worker_local

# Optional Docker code sandbox (disabled by default for safety)
# VERA_SANDBOX_ENABLED=true
# VERA_SANDBOX_TIMEOUT_MS=8000
# VERA_SANDBOX_MEMORY_MB=512
# VERA_SANDBOX_CPU_LIMIT=1.0
# VERA_SANDBOX_MAX_OUTPUT_CHARS=20000
# VERA_SANDBOX_HARDENED=true
# VERA_SANDBOX_USER=65532:65532
# VERA_SANDBOX_NOFILE=256:256
# VERA_SANDBOX_USE_IMAGE_LOCK=true
# VERA_SANDBOX_REQUIRE_LOCK_DIGEST=false
# VERA_SANDBOX_IMAGE_LOCK_FILE=tools/sandbox-images/images.lock.json
# VERA_SANDBOX_IMAGE_PYTHON=vera-sandbox-python:stable
# VERA_SANDBOX_IMAGE_JAVASCRIPT=vera-sandbox-javascript:stable
# VERA_SANDBOX_IMAGE_SHELL=vera-sandbox-shell:stable
