# Copy to .env and replace secrets for your environment.

# Memory backup hardening
VERA_BACKUP_MANIFEST_HMAC_KEY=replace-with-strong-secret
VERA_MAX_BACKUP_AGE_MS=86400000
VERA_BACKUP_INTERVAL_MS=3600000
VERA_MAX_MEMORY_BACKUPS=20

# Model backpressure and availability controls
VERA_MAX_PENDING_REQUESTS=20
VERA_REQUEST_TIMEOUT_MS=90000
VERA_MAX_RESTARTS_PER_WINDOW=5
VERA_RESTART_WINDOW_MS=60000
VERA_CIRCUIT_OPEN_MS=30000
VERA_MAX_EXTRACTED_FILE_TEXT_CHARS=50000

# Retrieval learning controls
VERA_RETRIEVAL_MAX_DOCS=5000
VERA_RETRIEVAL_CHUNK_SIZE=900
VERA_RETRIEVAL_CHUNK_OVERLAP=150
VERA_RETRIEVAL_TOP_K=4
VERA_RETRIEVAL_MAX_CONTEXT_CHARS=2800
VERA_RETRIEVAL_USE_EMBEDDINGS=true
VERA_RETRIEVAL_EMBED_DIM=128

# Conversation + tool loop controls
VERA_SHORT_TERM_HISTORY_TURNS=4
VERA_TOOL_MAX_ITERATIONS=2

# Per-route queue controls
VERA_MAX_PENDING_REQUESTS_PER_ROUTE=20

# Optional model router (disabled by default)
VERA_ROUTER_ENABLED=false
# VERA_MODEL_PATH=models/JSON-llama3-fp16.Q4_K_M.gguf
# VERA_ROUTER_CODER_MODEL=models/coder-specialist.gguf
# VERA_ROUTER_LEGAL_MODEL=models/legal-specialist.gguf
# VERA_ROUTER_FILE_MODEL=models/file-specialist.gguf

# Fine-tune pipeline paths (optional overrides)
# VERA_FINETUNE_APPROVED_FILE=training/approved_sessions.txt
# VERA_FINETUNE_DATASET_FILE=training/dataset.jsonl
# VERA_FINETUNE_OUTPUT_DIR=training/artifacts
# VERA_FINETUNE_BASE_MODEL=models/JSON-llama3-fp16.Q4_K_M.gguf

# Optional custom memory paths
# VERA_LONGTERM_FILE=memory/longterm.json
# VERA_SESSIONS_DIR=memory/sessions
# VERA_BACKUPS_DIR=memory/backups
# VERA_RETRIEVAL_INDEX_FILE=memory/retrieval_index.json

# Optional scoped auth for admin/memory endpoints
# VERA_ADMIN_API_KEY=replace-with-strong-api-key

# Worker controls
# VERA_WORKER_POLL_MS=2000
# VERA_WORKER_ID=worker_local

# Optional Docker code sandbox (disabled by default for safety)
# VERA_SANDBOX_ENABLED=true
# VERA_SANDBOX_TIMEOUT_MS=8000
# VERA_SANDBOX_MEMORY_MB=512
# VERA_SANDBOX_CPU_LIMIT=1.0
# VERA_SANDBOX_MAX_OUTPUT_CHARS=20000
# VERA_SANDBOX_HARDENED=true
# VERA_SANDBOX_USER=65532:65532
# VERA_SANDBOX_NOFILE=256:256
# VERA_SANDBOX_USE_IMAGE_LOCK=true
# VERA_SANDBOX_REQUIRE_LOCK_DIGEST=false
# VERA_SANDBOX_IMAGE_LOCK_FILE=tools/sandbox-images/images.lock.json
# VERA_SANDBOX_IMAGE_PYTHON=vera-sandbox-python:stable
# VERA_SANDBOX_IMAGE_JAVASCRIPT=vera-sandbox-javascript:stable
# VERA_SANDBOX_IMAGE_SHELL=vera-sandbox-shell:stable
